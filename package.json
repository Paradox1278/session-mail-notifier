{
  "name": "@local/session-mail-notifier",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Email a completion report when a chosen Session finishes a turn, sent from the mailbox bound on the plugin's Settings page",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "smtp.js",
    "store.js",
    "report.js",
    "queue.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
